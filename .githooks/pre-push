#!/bin/sh
# Pre-push gate: run repo verification before pushing.
# Bypass in emergencies: git push --no-verify.

echo "==> Backend tests"
(
  cd Backend || exit 1
  if [ -x .venv/bin/python3 ]; then PY=.venv/bin/python3; else PY=python3; fi
  "$PY" -m pytest tests/ -q || exit 1
) || exit 1

echo "==> Frontend lint"
(cd Frontend && npm run lint --silent) || exit 1

echo "==> Pre-push checks passed"
