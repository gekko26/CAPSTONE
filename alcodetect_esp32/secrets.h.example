/*
 * secrets.h.example — COPY THIS FILE TO secrets.h AND FILL IT IN.
 *
 *   cp secrets.h.example secrets.h
 *
 * `secrets.h` is GITIGNORED and must never be committed. `secrets.h.example` is
 * committed and must contain NO real values.
 *
 * ---------------------------------------------------------------------------
 * WHY THIS EXISTS
 * ---------------------------------------------------------------------------
 * The shared token authenticates POST /indicator on the gate device. Without it,
 * anybody on the LAN could post a fake "pass" verdict and turn a green light on at a
 * real gate. The firmware therefore refuses to build with a token only if you copy
 * this file; with no secrets.h at all the device compiles, answers 503 on
 * /indicator, and keeps every indicator LED off (fail closed, never green).
 *
 * There is currently NO token on /mode or /relay_test — see the open items in
 * docs/INDICATORS_WIRING.md.
 *
 * ---------------------------------------------------------------------------
 * HOW TO GENERATE A GOOD VALUE  (do not paste the result into a chat or a commit)
 * ---------------------------------------------------------------------------
 *   openssl rand -hex 32
 *
 * Set the SAME value in the backend environment variable:
 *   export ESP32_DEVICE_TOKEN='<paste here>'
 * Never echo it, never put it on a command line (it lands in shell history and in
 * `ps`), and never commit it.
 */

#ifndef ALCODETECT_SECRETS_H
#define ALCODETECT_SECRETS_H

/* Shared token for POST /indicator. At least 32 random hex characters.
 * Leave it as the placeholder and the device stays in fail-closed mode. */
static const char* DEVICE_TOKEN = "REPLACE_ME_WITH_A_RANDOM_32_BYTE_HEX_TOKEN";

/* ---------------------------------------------------------------------------
 * OPTIONAL: moving the Wi-Fi credentials out of the .ino
 * ---------------------------------------------------------------------------
 * They are currently inline at the top of alcodetect_esp32.ino and are therefore
 * committed in git history. To move them here, uncomment the two lines below AND
 * delete the `const char* WIFI_SSID` / `WIFI_PASSWORD` definitions from the .ino,
 * otherwise the build fails with a redefinition error.
 *
 * static const char* WIFI_SSID     = "your-network";
 * static const char* WIFI_PASSWORD = "your-password";
 *
 * Deliberately NOT done in this change: if the device is flashed without a real
 * secrets.h it would fail to join Wi-Fi at all, which is a worse failure than a
 * committed password. Do it as its own step, with the device on the bench.
 */

#endif /* ALCODETECT_SECRETS_H */